<?xml version="1.0" encoding="utf-8"?>
<!-- Candidate chip background -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/candidate_chip_background" />
    <corners android:radius="@dimen/chip_corner_radius" />
    <stroke
        android:width="1dp"
        android:color="#DEE2E6" />
    <padding
        android:left="@dimen/chip_horizontal_padding"
        android:top="@dimen/chip_vertical_padding"
        android:right="@dimen/chip_horizontal_padding"
        android:bottom="@dimen/chip_vertical_padding" />
</shape>
