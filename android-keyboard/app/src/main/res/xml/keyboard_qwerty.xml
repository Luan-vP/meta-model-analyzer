<?xml version="1.0" encoding="utf-8"?>
<!--
  Standard QWERTY keyboard layout for the Meta-Model keyboard.
  Uses the Android framework Keyboard XML format.
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:keyHeight="@dimen/keyboard_key_height"
    android:horizontalGap="0px"
    android:verticalGap="0px"
    android:keyPreviewLayout="@layout/key_preview">

    <!-- Row 1: q w e r t y u i o p -->
    <Row>
        <Key android:codes="113" android:keyLabel="q" android:keyEdgeFlags="left" />
        <Key android:codes="119" android:keyLabel="w" />
        <Key android:codes="101" android:keyLabel="e" />
        <Key android:codes="114" android:keyLabel="r" />
        <Key android:codes="116" android:keyLabel="t" />
        <Key android:codes="121" android:keyLabel="y" />
        <Key android:codes="117" android:keyLabel="u" />
        <Key android:codes="105" android:keyLabel="i" />
        <Key android:codes="111" android:keyLabel="o" />
        <Key android:codes="112" android:keyLabel="p" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 2: a s d f g h j k l -->
    <Row>
        <Key android:codes="97" android:keyLabel="a" android:keyEdgeFlags="left"
            android:keyWidth="11%p" />
        <Key android:codes="115" android:keyLabel="s" android:keyWidth="10.5%p" />
        <Key android:codes="100" android:keyLabel="d" android:keyWidth="10.5%p" />
        <Key android:codes="102" android:keyLabel="f" android:keyWidth="10.5%p" />
        <Key android:codes="103" android:keyLabel="g" android:keyWidth="10.5%p" />
        <Key android:codes="104" android:keyLabel="h" android:keyWidth="10.5%p" />
        <Key android:codes="106" android:keyLabel="j" android:keyWidth="10.5%p" />
        <Key android:codes="107" android:keyLabel="k" android:keyWidth="10.5%p" />
        <Key android:codes="108" android:keyLabel="l"
            android:keyWidth="11%p" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 3: shift z x c v b n m . shift -->
    <Row>
        <Key android:codes="-1" android:keyLabel="⇧"
            android:keyWidth="14%p" android:isModifier="true" android:keyEdgeFlags="left" />
        <Key android:codes="122" android:keyLabel="z" android:keyWidth="10%p" />
        <Key android:codes="120" android:keyLabel="x" android:keyWidth="10%p" />
        <Key android:codes="99" android:keyLabel="c" android:keyWidth="10%p" />
        <Key android:codes="118" android:keyLabel="v" android:keyWidth="10%p" />
        <Key android:codes="98" android:keyLabel="b" android:keyWidth="10%p" />
        <Key android:codes="110" android:keyLabel="n" android:keyWidth="10%p" />
        <Key android:codes="109" android:keyLabel="m" android:keyWidth="10%p" />
        <Key android:codes="46" android:keyLabel="." android:keyWidth="10%p" />
        <Key android:codes="-2" android:keyLabel="⇧"
            android:keyWidth="16%p" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 4: 123 , backspace done -->
    <Row>
        <Key android:codes="-3" android:keyLabel="123"
            android:keyWidth="14%p" android:keyEdgeFlags="left" />
        <Key android:codes="44" android:keyLabel=","
            android:keyWidth="11%p" />
        <Key android:codes="-5" android:keyIcon="@android:drawable/ic_menu_delete"
            android:keyWidth="22%p" android:isRepeatable="true" />
        <Key android:codes="32" android:keyLabel=" "
            android:keyWidth="33%p" android:isRepeatable="true" />
        <Key android:codes="-4" android:keyLabel="Done"
            android:keyWidth="20%p" android:keyEdgeFlags="right" />
    </Row>
</Keyboard>
